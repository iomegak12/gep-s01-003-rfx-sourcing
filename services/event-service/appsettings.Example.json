{
  "Kestrel": {
    "Endpoints": {
      "Http": {
        "Url": "http://0.0.0.0:5001"
      }
    }
  },
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "Enrich": [ "FromLogContext" ],
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Json.JsonFormatter, Serilog"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Persistence": {
    "DatabasePath": "./data/event_service.db",
    "ApplyMigrationsOnStartup": true,
    "SeedDataEnabled": true
  },
  "Jwt": {
    "Issuer": "rfx-auth-service",
    "Audience": "rfx-sourcing-system",
    "SigningKey": "REPLACE-WITH-AUTH-SERVICE-JWT_SIGNING_KEY-MIN-32-CHARS",
    "ClockSkewSeconds": 30
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
