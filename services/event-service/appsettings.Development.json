{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Information",
        "Microsoft.AspNetCore": "Information",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    }
  },
  "Persistence": {
    "DatabasePath": "./data/event_service.db",
    "ApplyMigrationsOnStartup": true,
    "SeedDataEnabled": true
  }
}
