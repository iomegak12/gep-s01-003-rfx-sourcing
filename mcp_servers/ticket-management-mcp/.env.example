# Database path (SQLite). The directory must be writable.
DATABASE_URL=sqlite:///./data/tickets.db

# MCP server bind address and port
MCP_HOST=0.0.0.0
MCP_PORT=8989

# Log level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Seed sample tickets on startup when the database is empty (true/false)
SEED_ON_STARTUP=true
# Force re-seed even when tickets already exist — for dev/reset only
SEED_FORCE=false
